# Copy to .env and edit.
# Local PostgreSQL: `docker compose up -d db` starts one that matches this URL.
DATABASE_URL="postgresql://nyaypath:nyaypath@localhost:5432/nyaypath"

# Required in production: a long random string (openssl rand -base64 48)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public site settings
NEXT_PUBLIC_SITE_NAME="ন্যায়পথ"
# Public base URL (used for metadata). No trailing slash.
SITE_URL="http://localhost:3000"

# Scheduling rules
MAX_APPOINTMENTS_PER_VOLUNTEER_PER_DAY=8

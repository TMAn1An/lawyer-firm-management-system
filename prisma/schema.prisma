generator client {
  provider = "prisma-client-js"
}

// SQLite keeps local setup to zero. To run on PostgreSQL change the provider
// to "postgresql" and point DATABASE_URL at your server (see docs/DEPLOYMENT.md).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Staff who sign in to the back office.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // ADMIN | STAFF
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  notes        CaseNote[]
}

/// Volunteer lawyers / paralegals who take appointments. Internal only: never shown publicly.
model Volunteer {
  id              String   @id @default(cuid())
  name            String
  categories      String   @default("") // comma separated category keys
  phone           String?
  email           String?
  availability    String   @default("AVAILABLE") // AVAILABLE | BUSY | ON_LEAVE
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  requests        HelpRequest[]
  cases           Case[]
}

/// A person who asked for help. Kept minimal on purpose.
model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  district  String?
  createdAt DateTime @default(now())
  requests  HelpRequest[]
  cases     Case[]
}

/// A request for free legal guidance; becomes an appointment once confirmed.
model HelpRequest {
  id            String   @id @default(cuid())
  refCode       String   @unique
  pinHash       String
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category      String
  summary       String
  district      String?
  preferredDate String?  // YYYY-MM-DD (Asia/Dhaka)
  mode          String   @default("IN_PERSON") // IN_PERSON | PHONE
  status        String   @default("SUBMITTED") // SUBMITTED | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
  volunteerId   String?
  volunteer     Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  date          String?  // confirmed YYYY-MM-DD
  slot          String?  // confirmed HH:MM
  publicNote    String?  // message the requester can see when tracking
  consentAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  case          Case?

  @@index([status, date])
  @@index([volunteerId, date])
}

model Case {
  id          String   @id @default(cuid())
  caseNo      String   @unique
  title       String
  category    String
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  outcome     String?
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  volunteerId String?
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  requestId   String?  @unique
  request     HelpRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  closedAt    DateTime?
  notes       CaseNote[]

  @@index([status])
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
